# Copy to .env.local for development. Never commit real values.
# In Vercel, set these under Project Settings -> Environment Variables.

# --- Database (required) ---------------------------------------------------
# Pooled connection used by the app at runtime (e.g. Neon "-pooler" host).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruitment?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/recruitment?schema=public"
# Throwaway database used only by `npm run db:check-drift` and CI.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruitment_shadow?schema=public"

# --- Application (required) ------------------------------------------------
# Public base URL, no trailing slash. Used in emails and canonical links.
APP_BASE_URL="http://localhost:3000"

# --- Email (required from Milestone 4) -------------------------------------
EMAIL_PROVIDER="console"            # "console" (dev: logs instead of sending) | "resend"
EMAIL_FROM="Recruitment <no-reply@example.org>"
EMAIL_STAFF_INBOX="recruitment@example.org"
RESEND_API_KEY=""

# --- Abuse protection (required from Milestone 4) ---------------------------
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Background jobs ---------------------------------------------------------
# Vercel sends this as a Bearer token to cron routes. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# --- Document storage (only if uploads are approved) ------------------------
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Development only ---------------------------------------------------------
# Set to "true" to let `npm run db:seed` insert SAMPLE content. Refused in production.
SEED_SAMPLE_CONTENT="false"
